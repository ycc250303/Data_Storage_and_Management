<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.hive.mapper.MovieMonthlyStatsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.hive.entity.MovieMonthlyStats">
        <id column="release_year" property="releaseYear" />
        <result column="release_month" property="releaseMonth" />
        <result column="total_movies" property="totalMovies" />
        <result column="avg_score" property="avgScore" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        release_year, release_month, total_movies, avg_score
    </sql>

</mapper>
