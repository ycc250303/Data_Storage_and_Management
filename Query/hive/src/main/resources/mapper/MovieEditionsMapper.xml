<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.hive.mapper.MovieEditionsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.hive.entity.MovieEditions">
        <id column="id" property="id" />
        <result column="movie_id" property="movieId" />
        <result column="version" property="version" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, movie_id, version
    </sql>
    
    <!-- 查询电影版本信息 -->
    <select id="getMovieEditionsByMovieTitle" resultType="java.util.Map">
        SELECT 
            m.movie_title,
            GROUP_CONCAT(DISTINCT me.edition SEPARATOR ',') AS edition_list
        FROM 
            movies m
        INNER JOIN 
            movie_editions me ON m.id = me.movie_id
        WHERE 
            m.movie_title LIKE CONCAT('%', #{movieTitle}, '%')
        GROUP BY 
            m.movie_title
    </select>

    <!-- 查询电影版本数量 -->
    <select id="getMovieEditionCountByMovieTitle" resultType="java.util.Map">
        SELECT 
            m.movie_title,
            COUNT(DISTINCT me.edition) AS edition_count
        FROM 
            movies m
        INNER JOIN 
            movie_editions me ON m.id = me.movie_id
        WHERE 
            m.movie_title = #{movieTitle}
        GROUP BY 
            m.movie_title
    </select>
</mapper>