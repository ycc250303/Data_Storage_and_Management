<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.mysql.mapper.MovieGenreStatsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.mysql.entity.MovieGenreStats">
        <id column="genre" property="genre" />
        <result column="total_movies" property="totalMovies" />
        <result column="average_score" property="averageScore" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        genre, total_movies, average_score
    </sql>

    <!-- 根据电影风格查询电影统计信息 -->
    <select id="getMovieCountByGenre" resultType="java.util.Map">
        SELECT genre, total_movies, average_score 
        FROM movie_genre_stats WHERE genre = #{movieGenre}
    </select>

</mapper>
