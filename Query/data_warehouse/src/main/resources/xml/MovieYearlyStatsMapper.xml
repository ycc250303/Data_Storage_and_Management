<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.mysql.mapper.MovieYearlyStatsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.mysql.entity.MovieYearlyStats">
        <id column="release_year" property="releaseYear" />
        <result column="total_movies" property="totalMovies" />
        <result column="avg_score" property="avgScore" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        release_year, total_movies, avg_score
    </sql>

    <!-- 根据年份查询电影统计信息 -->
    <select id="getMovieCountByYear" resultType="java.util.Map">
        SELECT release_year, total_movies, avg_score 
        FROM movie_yearly_stats WHERE release_year = #{year}
    </select>

</mapper>
