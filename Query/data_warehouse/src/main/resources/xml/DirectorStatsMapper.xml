<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.mysql.mapper.DirectorStatsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.mysql.entity.DirectorStats">
        <id column="director_id" property="directorId" />
        <result column="director_name" property="directorName" />
        <result column="movie_count" property="movieCount" />
        <result column="avg_score" property="avgScore" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        director_id, director_name, movie_count, avg_score
    </sql>

    <!-- 模糊匹配查询导演导演电影数量 -->
    <select id="getDirectorMovieCountByFuzzyName" resultType="java.util.Map">
        SELECT director_name, movie_count, avg_score 
        FROM director_stats 
        WHERE director_name LIKE CONCAT('%', #{directorName}, '%')
    </select>

</mapper>

