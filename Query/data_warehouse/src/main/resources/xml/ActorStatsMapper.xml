<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.mysql.mapper.ActorStatsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.mysql.entity.ActorStats">
        <id column="actor_id" property="actorId" />
        <result column="actor_name" property="actorName" />
        <result column="movie_count" property="movieCount" />
        <result column="avg_score" property="avgScore" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        actor_id, actor_name, movie_count, avg_score
    </sql>

    <!-- 模糊匹配查询演员参演电影数量 -->
    <select id="getActorMovieCountByFuzzyName" resultType="java.util.Map">
        SELECT actor_name, movie_count, avg_score 
        FROM actor_stats 
        WHERE actor_name LIKE CONCAT('%', #{actorName}, '%')
    </select>

</mapper>

