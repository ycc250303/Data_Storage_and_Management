<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.mysql.mapper.MovieMonthlyStatsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.mysql.entity.MovieMonthlyStats">
        <result column="release_year" property="releaseYear" />
        <result column="release_month" property="releaseMonth" />
        <result column="total_movies" property="totalMovies" />
        <result column="avg_score" property="avgScore" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        release_year, release_month, total_movies, avg_score
    </sql>

    <!-- 根据年份和月份查询电影统计信息 -->
    <select id="getMovieCountByYearAndMonth" resultType="java.util.Map">
        SELECT release_year, release_month, total_movies, avg_score 
        FROM movie_monthly_stats WHERE release_year = #{year} AND release_month = #{month}
    </select>

    <!-- 根据年份和季度查询电影统计信息 -->
    <select id="getMovieCountByYearAndQuarter" resultType="java.util.Map">
        SELECT #{year} as release_year, #{quarter} as release_quarter, 
        SUM(total_movies) as total_movies 
        FROM movie_monthly_stats WHERE release_year = #{year} AND release_month &lt;= #{quarter} * 3
    </select>

</mapper>
