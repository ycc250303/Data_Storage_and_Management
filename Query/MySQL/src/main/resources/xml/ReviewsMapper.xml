<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.mysql.mapper.ReviewsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.mysql.entity.Reviews">
        <id column="id" property="id" />
        <result column="review_uuid" property="reviewUuid" />
        <result column="movie_id" property="movieId" />
        <result column="helpfulness" property="helpfulness" />
        <result column="profile_name" property="profileName" />
        <result column="score" property="score" />
        <result column="created_ts" property="createdTs" />
        <result column="summary" property="summary" />
        <result column="content" property="content" />
        <result column="user_id" property="userId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, review_uuid, movie_id, helpfulness, profile_name, score, created_ts, summary, content, user_id
    </sql>

</mapper>
