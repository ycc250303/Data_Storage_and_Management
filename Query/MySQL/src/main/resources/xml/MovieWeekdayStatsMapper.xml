<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.query.mysql.mapper.MovieWeekdayStatsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.query.mysql.entity.MovieWeekdayStats">
        <result column="release_weekday" property="releaseWeekday" />
        <result column="total_movies" property="totalMovies" />
        <result column="avg_score" property="avgScore" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        release_weekday, total_movies, avg_score
    </sql>

    <!-- 根据星期查询电影统计信息 -->
    <select id="getMovieCountByWeekday" resultType="java.util.Map">
        SELECT total_movies, 
        CASE release_weekday 
            WHEN 0 THEN '周一' 
            WHEN 1 THEN '周二' 
            WHEN 2 THEN '周三' 
            WHEN 3 THEN '周四' 
            WHEN 4 THEN '周五' 
            WHEN 5 THEN '周六' 
            WHEN 6 THEN '周日' 
        END as weekday_name 
        FROM movie_weekday_stats WHERE release_weekday = #{weekday}
    </select>

</mapper>

